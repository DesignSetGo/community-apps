{
  "$id": "https://github.com/DesignSetGo/community-apps/schema/app.schema.json",
  "title": "Community app entry",
  "type": "object",
  "required": ["slug", "title", "blurb", "author", "repo", "shape", "isolation"],
  "additionalProperties": false,
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$",
      "minLength": 2,
      "maxLength": 60
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 80
    },
    "blurb": {
      "type": "string",
      "minLength": 10,
      "maxLength": 200,
      "not": { "pattern": "<[a-zA-Z!/]" }
    },
    "author": {
      "type": "object",
      "required": ["github"],
      "additionalProperties": false,
      "properties": {
        "name":   { "type": "string", "maxLength": 80 },
        "github": { "type": "string", "pattern": "^[a-zA-Z0-9](?:[a-zA-Z0-9-]*[a-zA-Z0-9])?$" },
        "url":    { "type": "string", "format": "uri", "pattern": "^https://" }
      }
    },
    "repo": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://github\\.com/[^/]+/[^/]+/?$"
    },
    "live_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "screenshot": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "tags": {
      "type": "array",
      "maxItems": 6,
      "items": { "type": "string", "minLength": 2, "maxLength": 30 }
    },
    "shape": {
      "type": "string",
      "enum": ["block", "in-post", "full-page", "tool"]
    },
    "isolation": {
      "type": "string",
      "enum": ["iframe", "inline"]
    },
    "bridge_methods": {
      "type": "array",
      "items": { "type": "string", "pattern": "^dsgo\\.[a-z]" }
    },
    "added": {
      "type": "string",
      "format": "date"
    }
  }
}
